generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WorkspaceSession {
  id              String   @id @default(cuid())
  name            String?
  rawAnalysis     Json
  finalProposal   Json
  autonomousTrace Json[]   @default([])
  chatHistory     Json[]   @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
}
